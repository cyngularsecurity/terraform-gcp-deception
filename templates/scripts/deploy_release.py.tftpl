#!/usr/bin/env python3
"""Promote a build artifact to the production release channel."""
import json
import subprocess
import sys

RELEASE_BUCKET = "prod-release-artifacts"
REGISTRY = "us-docker.pkg.dev/platform-prod/services"

${credentials}


def promote(version):
    print(f"Promoting {version} to {RELEASE_BUCKET}")
    subprocess.run(
        ["gcloud", "storage", "cp", f"build/{version}.tar.gz",
         f"gs://{RELEASE_BUCKET}/{version}/"],
        check=True,
    )


if __name__ == "__main__":
    promote(sys.argv[1] if len(sys.argv) > 1 else "latest")
